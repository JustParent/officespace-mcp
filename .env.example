# Copy the actual GraphQL POST URL and authentication header from your tenant's GraphiQL setup.
# /api/base/graphiql is the documentation UI, not necessarily the POST endpoint.
OFFICESPACE_GRAPHQL_URL=https://your-tenant.officespacesoftware.com/REPLACE_WITH_GRAPHQL_PATH
OFFICESPACE_AUTH_HEADER=Authorization
OFFICESPACE_AUTH_VALUE=REPLACE_WITH_COMPLETE_HEADER_VALUE
OFFICESPACE_ENABLE_MUTATIONS=false

# Required for streamable-http; separate from the OfficeSpace credential.
MCP_BEARER_TOKEN=
# Add your public host when using a reverse proxy, e.g. mcp.example.com
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*

# Optional replacement SDL or introspection JSON schema.
# OFFICESPACE_SCHEMA_PATH=/absolute/path/schema.json
