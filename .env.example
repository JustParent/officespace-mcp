# The key is sent in an `apikey` header. Create one in OfficeSpace under
# Admin > Integrations > API Keys (shown only once).
OFFICESPACE_GRAPHQL_URL=https://api.officespacesoftware.com/graphql
OFFICESPACE_AUTH_VALUE=REPLACE_WITH_API_KEY
OFFICESPACE_ENABLE_MUTATIONS=false

# Required for streamable-http; separate from the OfficeSpace credential.
MCP_BEARER_TOKEN=
# Add your public host when using a reverse proxy, e.g. mcp.example.com
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*

# Optional replacement SDL or introspection JSON schema.
# OFFICESPACE_SCHEMA_PATH=/absolute/path/schema.json
